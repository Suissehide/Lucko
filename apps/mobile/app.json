{
  "expo": {
    "name": "Lucko",
    "slug": "lucko",
    "scheme": "lucko",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.lucko.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.lucko.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF1D6"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lucko utilise ta position pour te montrer les lieux et les soirées de jeu autour de toi."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lucko accède à tes photos pour que tu choisisses ta photo de profil.",
          "cameraPermission": "Lucko utilise la caméra pour scanner le QR Lucko des joueurs au comptoir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Lucko ajoute tes parties à ton calendrier quand tu le demandes.",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Lucko ajoute tes parties à ton calendrier quand tu le demandes.",
          "remindersPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lucko utilise la caméra pour scanner le QR Lucko des joueurs au comptoir.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "362d517e-6c51-4bbd-8f6c-074df517fa6e"
      }
    }
  }
}
