{
  "expo": {
    "name": "Lucko",
    "slug": "lucko",
    "scheme": "lucko",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.lucko.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.lucko.app",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lucko utilise ta position pour te montrer les lieux et les soirées de jeu autour de toi."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lucko accède à tes photos pour que tu choisisses ta photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Lucko ajoute tes parties à ton calendrier quand tu le demandes.",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Lucko ajoute tes parties à ton calendrier quand tu le demandes.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
