// Schéma initial Lucko. Voir Obsidian « Architecture fonctionnelle — app joueurs » §16.
// Après modification : `pnpm db:migrate` (crée la migration) puis commit du dossier migrations/.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Joueurs ----------

enum UserRole {
  PLAYER
  VENUE_STAFF
  ADMIN
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  /// Nom transmis par Apple / Google (champ `name` de Better Auth), jamais montré aux autres joueurs
  name              String              @default("")
  emailVerified     Boolean             @default(false)
  image             String?
  /// Choisi à l'onboarding (LKO-45) : null juste après la création du compte
  pseudo            String?             @unique
  /// Saisie à l'inscription par e-mail, demandée après une première connexion Apple / Google
  birthDate         DateTime?           @db.Date
  role              UserRole            @default(PLAYER)
  /// Photo de profil : visible des autres joueurs seulement une fois validée (sinon l'initiale)
  avatarUrl         String?
  avatarStatus      AvatarStatus?
  city              String?
  /// Centre de la ville choisie (géocodage IGN) ou position de l'appareil (« Me localiser »)
  latitude          Float?
  longitude         Float?
  searchRadiusKm    Int                 @default(10)
  /// Créneaux habituels : jour × 3 + moment (0 = lundi matin … 20 = dimanche soir)
  availability      Int[]               @default([])
  vibes             PlayVibe[]          @default([])
  /// Compte parent lié (mineurs de 13-14 ans)
  parentId          String?
  parent            User?               @relation("ParentChild", fields: [parentId], references: [id])
  children          User[]              @relation("ParentChild")
  parentalConsentAt DateTime?
  /// Version de l'avertissement sécurité des rooms à domicile acceptée (LKO-72)
  homeSafetyVersion Int?
  xp                Int                 @default(0)
  /// Sujets de notifications push coupés par le joueur (tout est activé par défaut)
  notificationsOff  NotificationTopic[] @default([])
  /// « Je veux jouer à… » : soir, week-end ou peu importe (LKO-17)
  playWhen          PlayWhen            @default(ANY)
  /// Suspendu par un admin (LKO-20) : plus de connexion ; `suspendedUntil` null = définitive
  suspendedAt       DateTime?
  suspendedUntil    DateTime?
  suspendedReason   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  gameProfiles       PlayerGameProfile[]
  hostedRooms        Room[]              @relation("RoomHost")
  participations     RoomParticipant[]
  visits             Visit[]
  staffOf            VenueStaff[]
  eventRegistrations EventRegistration[]
  sessions           Session[]
  accounts           Account[]
  /// Jeux joués (LKO-46) ; le niveau par format TCG est dans PlayerGameProfile
  playedGames        Game[]              @relation("PlayedGames")
  blocksGiven        Block[]             @relation("BlocksGiven")
  blocksReceived     Block[]             @relation("BlocksReceived")
  reportsMade        Report[]            @relation("ReportsMade")
  reportsReceived    Report[]            @relation("ReportsReceived")
  pushTokens         PushToken[]
  adminActions       AdminAction[]
  messages           Message[]
  conversationReads  ConversationRead[]
  playIntents        PlayIntent[]
  createdEvents      Event[]             @relation("EventCreatedBy")
  createdEventSeries EventSeries[]
}

enum NotificationTopic {
  ROOMS
  MESSAGES
  VENUES
  GAMES
}

/// Moment où le joueur veut être prévenu d'une room de ses envies (LKO-17)
enum PlayWhen {
  EVENING
  WEEKEND
  ANY
}

/// Appareil d'un joueur : jeton Expo Push (LKO-108). Un appareil change de joueur s'il s'y reconnecte.
model PushToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum AvatarStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Ambiance recherchée, affichée sur le profil
enum PlayVibe {
  CHILL
  COMPETITIVE
  TEACHER
  BEGINNER
  HOMEBREW
  SOCIAL
}

/// Ambiance d'une room, choisie par l'hôte
enum RoomVibe {
  CHILL
  COMPETITIVE
  BEGINNERS_WELCOME
  LENDS_DECKS
  ENGLISH_OK
}

/// Catégorie d'une room jeux de société (pas de format)
enum BoardGameCategory {
  STRATEGY
  AMBIANCE
  COOPERATIVE
  FAMILY
  INVESTIGATION
  ROLE_PLAYING
  WARGAME
  PARTY
}

// ---------- Auth (tables Better Auth, LKO-9) ----------

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Moyen de connexion : `credential` (e-mail + mot de passe haché), `apple` ou `google`
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Jeux ----------

enum GameKind {
  TCG
  BOARD_GAME
}

model Game {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  kind        GameKind
  minPlayers  Int           @default(2)
  maxPlayers  Int           @default(4)
  formats     GameFormat[]
  rooms       Room[]
  events      Event[]       @relation("EventGames")
  eventSeries EventSeries[] @relation("EventSeriesGames")
  /// Lieux où ce jeu est disponible sur place
  venues      Venue[]       @relation("VenueGames")
  /// Joueurs qui le déclarent dans leurs jeux (LKO-46)
  players     User[]        @relation("PlayedGames")
  intents     PlayIntent[]
}

model GameFormat {
  id              String              @id @default(cuid())
  slug            String
  name            String
  gameId          String
  game            Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Joueurs par partie (LKO-52) : 2 en duel, 2 à 5 en Commander, 6 à 8 en draft
  minPlayers      Int                 @default(2)
  maxPlayers      Int                 @default(2)
  /// Durée moyenne d'une partie, en minutes
  durationMinutes Int                 @default(60)
  /// Commander : brackets officiels Wizards 1 à 5 (puissance du deck)
  hasBrackets     Boolean             @default(false)
  profiles        PlayerGameProfile[]
  rooms           Room[]

  @@unique([gameId, slug])
}

enum DeclaredLevel {
  BEGINNER
  INTERMEDIATE
  CONFIRMED
  EXPERT
}

/// Niveau d'un joueur sur un format TCG : LK (Elo, départ 1000) et fiabilité.
model PlayerGameProfile {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  formatId       String
  format         GameFormat    @relation(fields: [formatId], references: [id], onDelete: Cascade)
  declaredLevel  DeclaredLevel @default(INTERMEDIATE)
  rating         Int           @default(1000)
  rankedGames    Int           @default(0)
  reliabilityPct Int           @default(0)
  updatedAt      DateTime      @updatedAt

  history RatingChange[]

  @@unique([userId, formatId])
}

/// Historique des LK : une ligne par joueur et par partie classée confirmée (LKO-86).
model RatingChange {
  id           String            @id @default(cuid())
  profileId    String
  profile      PlayerGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Room classée d'origine (null pour un tournoi, ou si la room a été supprimée)
  roomId       String?
  room         Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratingBefore Int
  ratingAfter  Int
  place        Int
  /// Adversaires de la partie : sert à la variété de l'indice de fiabilité
  opponentIds  String[]
  createdAt    DateTime          @default(now())

  @@index([profileId, createdAt])
}

// ---------- Lieux ----------

enum VenueType {
  GAME_BAR
  TCG_SHOP
  LUDOTHEQUE
  ASSOCIATION
  OTHER
}

/// Lieu proposé ou importé : visible des joueurs seulement une fois publié par un admin (LKO-20)
enum VenueStatus {
  PENDING
  PUBLISHED
}

model Venue {
  id                         String                                 @id @default(cuid())
  status                     VenueStatus                            @default(PUBLISHED)
  slug                       String                                 @unique
  name                       String
  type                       VenueType
  address                    String
  city                       String
  latitude                   Float
  longitude                  Float
  /// Point PostGIS, rempli par une migration SQL / un trigger à partir de latitude/longitude
  location                   Unsupported("geography(Point, 4326)")?
  isPartner                  Boolean                                @default(false)
  /// Bars (débits de boissons) : pas de moins de 16 ans non accompagnés
  acceptsUnaccompaniedMinors Boolean                                @default(false)
  description                String?
  /// Droit de jeu par personne (centimes) ; null = gratuit ou non renseigné
  playFeeCents               Int?
  /// Consommation minimum par personne (centimes)
  minSpendCents              Int?
  /// Avantage Lucko proposé aux joueurs (lieux partenaires), ex. « -10 % sur les boosters »
  luckoPerk                  String?
  /// Quartier affiché après la ville, ex. « Saint-Pierre »
  quarter                    String?
  phone                      String?
  website                    String?
  /// Transports à proximité, ex. « Tram A et B · Porte de Bourgogne, 4 min à pied »
  transitInfo                String?
  /// Accessibilité : [{ label, status: YES | NO | INFO, note? }] (schéma Zod dans @lucko/shared)
  accessibility              Json                                   @default("[]")
  /// Note sous les TCG, ex. « Salle TCG de 12 tables, tapis au comptoir »
  tcgNote                    String?
  /// Ludothèque : quelques titres mis en avant, le total (« 300+ ») et une note
  boardGames                 String[]                               @default([])
  boardGameCount             Int?
  boardGameNote              String?
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt

  staff        VenueStaff[]
  rooms        Room[]
  events       Event[]
  eventSeries  EventSeries[]
  visits       Visit[]
  openingHours VenueOpeningHours[]
  closures     VenueClosure[]
  photos       VenuePhoto[]
  /// Jeux disponibles sur place
  games        Game[]              @relation("VenueGames")

  @@index([city])
  @@index([location], type: Gist)
}

/// Plage d'ouverture hebdomadaire ; plusieurs plages possibles le même jour.
/// Minutes depuis minuit ; closesAtMinute < opensAtMinute = fermeture après minuit.
model VenueOpeningHours {
  id             String @id @default(cuid())
  venueId        String
  venue          Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// 1 = lundi … 7 = dimanche (ISO 8601)
  weekday        Int
  opensAtMinute  Int
  closesAtMinute Int

  @@index([venueId])
}

enum ClosureKind {
  CLOSED
  SPECIAL_HOURS
}

/// Fermeture exceptionnelle ou horaires modifiés, du `startsOn` au `endsOn` inclus (dates locales).
/// Remplace les horaires de la semaine ces jours-là.
model VenueClosure {
  id             String      @id @default(cuid())
  venueId        String
  venue          Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  startsOn       DateTime    @db.Date
  endsOn         DateTime    @db.Date
  kind           ClosureKind @default(CLOSED)
  label          String
  note           String?
  /// SPECIAL_HOURS uniquement
  opensAtMinute  Int?
  closesAtMinute Int?

  @@index([venueId, endsOn])
}

model VenuePhoto {
  id      String  @id @default(cuid())
  venueId String
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url     String
  caption String?
  order   Int     @default(0)

  @@index([venueId, order])
}

enum VenueStaffRole {
  MANAGER
  STAFF
}

model VenueStaff {
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId String
  venue   Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role    VenueStaffRole @default(STAFF)

  @@id([userId, venueId])
}

// ---------- Rooms ----------

enum RoomMode {
  RANKED
  CASUAL
}

enum RoomStatus {
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Room {
  id                   String      @id @default(cuid())
  hostId               String
  host                 User        @relation("RoomHost", fields: [hostId], references: [id])
  gameId               String
  game                 Game        @relation(fields: [gameId], references: [id])
  formatId             String?
  format               GameFormat? @relation(fields: [formatId], references: [id])
  mode                 RoomMode    @default(CASUAL)
  status               RoomStatus  @default(OPEN)
  venueId              String?
  venue                Venue?      @relation(fields: [venueId], references: [id])
  /// Domicile (LKO-71) : seule la zone floue est publique ; l'adresse est dans RoomPrivateAddress
  atHome               Boolean     @default(false)
  /// Quartier affiché, ex. « Bordeaux · Saint-Michel »
  homeAreaLabel        String?
  /// Centre de la zone floue : point réel décalé au hasard une fois pour toutes, à la création
  fuzzyLat             Float?
  fuzzyLng             Float?
  startsAt             DateTime
  capacity             Int
  minorsAllowed        Boolean     @default(false)
  autoAccept           Boolean     @default(false)
  description          String?
  /// Bracket Commander visé (1 à 5), seulement pour un format qui en a (LKO-52)
  bracket              Int?
  boardGameCategory    BoardGameCategory?
  vibes                RoomVibe[]         @default([])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  participants   RoomParticipant[]
  ratingChanges  RatingChange[]
  conversation   Conversation?
  privateAddress RoomPrivateAddress?

  @@index([startsAt])
}

/// Adresse d'une room à domicile, chiffrée (AES-256-GCM) : révélée aux acceptés 24 h avant, supprimée après la room
model RoomPrivateAddress {
  roomId     String @id
  room       Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Adresse et position exacte (JSON) chiffrées, tag GCM compris
  ciphertext Bytes
  iv         Bytes
  /// Clé de chiffrement utilisée, pour la rotation
  keyVersion Int
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  DECLINED
  LEFT
}

model RoomParticipant {
  roomId      String
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ParticipantStatus @default(PENDING)
  checkedInAt DateTime?
  createdAt   DateTime          @default(now())

  @@id([roomId, userId])
}

// ---------- Événements des lieux ----------

enum EventType {
  GAME_NIGHT
  INITIATION
  TOURNAMENT
  PRERELEASE
  THEMED
}

enum RegistrationMode {
  /// Entrée libre, pas d'inscription
  NONE
  /// Inscription dans l'app (places limitées par `capacity`)
  IN_APP
  /// Inscription sur un site externe (EventLink, HelloAsso…) via `externalUrl`
  EXTERNAL
}

/// Brouillon (visible du lieu seulement), publié, annulé (inscrits prévenus) ou masqué par un admin.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  HIDDEN
}

/// Événement récurrent (LKO-61) : la règle (RRULE, sous-ensemble dans @lucko/shared) et le modèle
/// des occurrences. Un job quotidien crée les occurrences (Event) sur 3 mois glissants.
model EventSeries {
  id                String           @id @default(cuid())
  venueId           String
  venue             Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Ex. « FREQ=WEEKLY;INTERVAL=2;BYDAY=FR », « FREQ=MONTHLY;BYDAY=1FR »
  rrule             String
  /// Date locale (heure de Paris) de la première occurrence
  startDate         DateTime         @db.Date
  /// Dernière date possible (incluse) ; null = sans fin
  untilDate         DateTime?        @db.Date
  /// Heure de début, en minutes depuis minuit à l'heure du lieu
  startMinute       Int
  durationMinutes   Int?
  /// DRAFT / PUBLISHED : statut des nouvelles occurrences ; CANCELLED / HIDDEN : plus d'occurrence créée
  status            EventStatus      @default(PUBLISHED)
  /// Occurrences créées jusqu'à cette date locale (exclue)
  materializedUntil DateTime         @db.Date
  games             Game[]           @relation("EventSeriesGames")
  type              EventType
  title             String
  description       String?
  capacity          Int?
  priceCents        Int?
  minAge            Int?
  registrationMode  RegistrationMode @default(IN_APP)
  externalUrl       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  occurrences Event[]

  @@index([venueId])
  @@index([status, materializedUntil])
}

/// Une occurrence datée : ponctuelle, ou créée par sa série (`seriesId`, `occurrenceDate`).
/// Chaque date a ses propres inscrits. `overridden` : modifiée seule, la série ne l'écrase plus.
model Event {
  id               String           @id @default(cuid())
  venueId          String
  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// Jeux concernés (vide = tous jeux, ex. soirée jeux de société libre)
  games            Game[]           @relation("EventGames")
  type             EventType
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime?
  capacity         Int?
  priceCents       Int?
  minAge           Int?
  registrationMode RegistrationMode @default(IN_APP)
  externalUrl      String?
  status           EventStatus      @default(PUBLISHED)
  seriesId         String?
  series           EventSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Date locale prévue par la série (même si l'occurrence a été déplacée) : jamais recréée
  occurrenceDate   DateTime?        @db.Date
  overridden       Boolean          @default(false)
  createdById      String?
  createdBy        User?            @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  registrations EventRegistration[]
  conversation  Conversation?
  reports       Report[]

  @@unique([seriesId, occurrenceDate])
  @@index([venueId, startsAt])
  @@index([startsAt])
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

/// Inscription d'un joueur à un événement (un seul enregistrement par joueur et par événement).
model EventRegistration {
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RegistrationStatus @default(REGISTERED)
  /// Présence pointée par le lieu (pointage, LKO-78)
  checkedInAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([eventId, userId])
  @@index([userId])
}

// ---------- Chat (LKO-80) ----------

/// Fil de discussion d'une room ou d'un événement (tournoi), créé au premier message ou à la première lecture.
model Conversation {
  id        String   @id @default(cuid())
  roomId    String?  @unique
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  eventId   String?  @unique
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]
}

enum MessageKind {
  MESSAGE
  /// Annonce de l'hôte ou de l'organisateur : épinglée et notifiée à tous
  ANNOUNCEMENT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  /// Texte et emojis seulement en v1
  body           String
  kind           MessageKind  @default(MESSAGE)
  createdAt      DateTime     @default(now())
  /// Supprimé par son auteur, l'hôte ou l'organisateur : plus montré, gardé pour la modération
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([authorId, createdAt])
}

/// Où en est un joueur dans une conversation : dernier passage (non-lus) et sourdine des push.
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

// ---------- Venues facturables ----------

enum VisitSource {
  QR_SCAN
  CHECK_IN
}

/// Une venue = un joueur dans un lieu un soir. Un seul forfait par joueur, par lieu et par soirée.
model Visit {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  venueId      String
  venue        Venue       @relation(fields: [venueId], references: [id])
  source       VisitSource
  /// Soirée de rattachement (date locale Europe/Paris)
  businessDate DateTime    @db.Date
  spentCents   Int?
  billable     Boolean     @default(false)
  /// Nonce du QR Lucko scanné (LKO-77) : un jeton ne sert qu'une fois, même dans un autre lieu
  qrNonce      String?     @unique
  createdAt    DateTime    @default(now())

  @@unique([userId, venueId, businessDate])
}

// ---------- Modération (LKO-19) ----------

/// Blocage d'un joueur par un autre. Effet dans les deux sens : aucun des deux ne voit plus l'autre.
/// « Je veux jouer à… » (LKO-17) : le joueur est prévenu quand une room de ce jeu s'ouvre dans son
/// rayon, autour de sa ville (jamais sa position précise). Expire au bout de PLAY_INTENT_DAYS.
model PlayIntent {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  /// Dernière notification pour ce jeu (anti-spam)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([userId, gameId])
  @@index([gameId, expiresAt])
}

model Block {
  blockerId String
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Motif de signalement (identique à REPORT_REASONS dans @lucko/shared)
enum ReportReason {
  HARASSMENT
  INAPPROPRIATE_CONTENT
  CHEATING
  NO_SHOW
  MINOR_SAFETY
  SAFETY
  OTHER
}

/// Signalement d'un joueur (ou d'un événement, LKO-61), traité par un admin. Gardé après la suppression des comptes (preuve).
model Report {
  id         String            @id @default(cuid())
  reporterId String
  reporter   User              @relation("ReportsMade", fields: [reporterId], references: [id])
  targetId   String
  target     User              @relation("ReportsReceived", fields: [targetId], references: [id])
  /// Événement signalé (LKO-61) ; la cible est alors son créateur
  eventId    String?
  event      Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reason     ReportReason
  details    String            @default("")
  createdAt  DateTime          @default(now())
  /// null tant que le signalement est dans la file des admins
  resolvedAt DateTime?
  resolution ReportResolution?

  @@index([resolvedAt, createdAt])
  @@index([targetId])
}

enum ReportResolution {
  DISMISSED
  WARNED
  SUSPENDED
}

// ---------- Back-office admin (LKO-20) ----------

enum AdminActionKind {
  REPORT_DISMISS
  REPORT_WARN
  REPORT_SUSPEND
  USER_SUSPEND
  USER_UNSUSPEND
  AVATAR_APPROVE
  AVATAR_REJECT
  VENUE_UPDATE
  EVENT_CREATE
  EVENT_UPDATE
  EVENT_CANCEL
  EVENT_HIDE
  GAME_MERGE
}

/// Journal d'audit : chaque action d'un admin (qui, quoi, quand, cible, motif). Jamais modifié ni supprimé.
model AdminAction {
  id        String          @id @default(cuid())
  adminId   String
  admin     User            @relation(fields: [adminId], references: [id])
  action    AdminActionKind
  /// Id de la cible (signalement, joueur, lieu, événement, jeu supprimé), selon l'action
  targetId  String
  reason    String          @default("")
  /// Corps de la requête, pour retrouver le détail (durée, champs modifiés, jeu cible)
  data      Json?
  createdAt DateTime        @default(now())

  @@index([targetId])
  @@index([createdAt])
}

// ---------- Liste d'attente (landing) ----------

/// Joueur inscrit à la liste d'attente du site, avant l'ouverture de l'app (LKO-3).
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())
}
