{
  "name": "@lucko/api",
  "version": "0.0.0",
  "private": true,
  "description": "API Lucko (NestJS + PostgreSQL/PostGIS via Prisma)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "tsc -p tsconfig.build.json --outDir .openapi && node .openapi/generate-openapi.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "address-keys:rotate": "tsx src/rooms/rotate-address-key.ts",
    "venues:import-osm": "tsx src/venues/import-osm-venues.ts",
    "db:reset": "prisma migrate reset --force && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@better-auth/expo": "1.7.7",
    "@lucko/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "dotenv": "^18.0.5",
    "nodemailer": "^10.0.15",
    "pg-boss": "^12.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
