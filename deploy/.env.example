# Variables du déploiement Dokploy (deploy/dokploy/docker-compose.dokploy.yml),
# à renseigner dans l'onglet Environment du service. Ne jamais committer les vraies valeurs.
# Staging et production ont chacun leur service Compose : domaines, secrets et base distincts.

# Images : nom propre à chaque environnement (lucko / lucko-staging), sinon le build
# de l'un écrase l'image de l'autre sur le même serveur
APP_IMAGE_NAME=lucko
VERSION=0.1.0

# API
# Origines autorisées (site public + app web), séparées par des virgules
CORS_ORIGINS="https://lucko.example.com,https://app.lucko.example.com"
# URL publique de l'API (base des retours Apple / Google : <URL>/api/auth/callback/google|apple)
BETTER_AUTH_URL="https://api.lucko.example.com"
# Secret obligatoire, 32 caractères min. : `openssl rand -base64 32`
BETTER_AUTH_SECRET=CHANGE_ME
# Clés de chiffrement des adresses de rooms à domicile, obligatoire : `1:` + `openssl rand -base64 32`
# Rotation : ajouter `2:<nouvelle clé>,` en tête ; l'ancienne peut être retirée 61 jours plus tard,
# ou tout de suite après `node dist/rooms/rotate-address-key.js` dans le conteneur de l'API (clé compromise)
HOME_ADDRESS_KEYS=1:CHANGE_ME
# Connexion Google / Apple (facultatif, cf. .env.example à la racine)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Notifications push : seulement si la sécurité des push est activée sur le projet Expo
EXPO_ACCESS_TOKEN=
# E-mails (confirmation, mot de passe oublié, sanctions) : Resend en SMTP, obligatoire en pratique
# (sans SMTP_URL en production, aucun e-mail ne part)
SMTP_URL="smtps://resend:CHANGE_ME@smtp.resend.com:465"
MAIL_FROM="Lucko <noreply@lucko.fr>"
# Photos (profils, lieux) : bucket S3 en UE, ex. Scaleway ; sans bucket, l'envoi de photo répond 503
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION=fr-par
S3_BUCKET=lucko
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Base publique des fichiers (bucket ou CDN)
S3_PUBLIC_URL="https://lucko.s3.fr-par.scw.cloud"
# Analyse automatique des photos (sightengine.com), facultatif : sans clé, chaque photo attend un admin
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Suivi des erreurs (LKO-36) : DSN des projets GlitchTip (deploy/glitchtip), un par appli ; vide = rien n'est envoyé.
# Les DSN du site et de l'app sont figés au build.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_APP=
# staging ou production (même GlitchTip, environnements séparés)
SENTRY_ENVIRONMENT=production
# Serveurs Overpass de l'import des lieux OSM ; vide = public puis miroirs (voir apps/api/src/config/env.ts)
OVERPASS_URLS=

# Site (Next.js) : URL publique de l'API, figée au build
NEXT_PUBLIC_API_URL="https://api.lucko.example.com"
# Site (Next.js) : URL publique du site (canonique, sitemap, partage), figée au build
NEXT_PUBLIC_SITE_URL="https://lucko.example.com"

# App web (Expo) : URL publique de l'API, figée au build
EXPO_PUBLIC_API_URL="https://api.lucko.example.com"
# App web (Expo) : mesure d'audience Umami, figée au build ; vide = rien n'est envoyé
EXPO_PUBLIC_UMAMI_WEBSITE_ID=

# Postgres (PostGIS)
POSTGRES_USER=lucko
# Secret : générer une valeur aléatoire, ex. `openssl rand -hex 32`
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=lucko
