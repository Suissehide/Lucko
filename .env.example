# Copier ce fichier en `.env` à la racine (et dans apps/api) : `cp .env.example .env`
# --- API ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://lucko:lucko@localhost:5469/lucko?schema=public
CORS_ORIGINS=http://localhost:3010,http://localhost:8081
# Dev uniquement : l'en-tête `x-dev-user-id: <id d'un User>` vaut connexion (comptes du seed, sans mot de passe)
DEV_AUTH_HEADER=true

# --- Connexion (Better Auth) ---
# URL publique de l'API (base des retours Apple / Google : <URL>/api/auth/callback/google|apple)
BETTER_AUTH_URL=http://localhost:3000
# Obligatoire en production, 32 caractères min. : `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`
# BETTER_AUTH_SECRET=
# Google : console Google Cloud > Identifiants > ID client OAuth (type « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : Services ID (ex. fr.lucko.app.signin) ; le secret est un JWT signé avec la clé .p8 (Team ID + Key ID),
# valable 6 mois maximum : à régénérer avant expiration
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# E-mails : hors production, Mailpit (pnpm db:up, boîte sur http://localhost:8025) sans rien renseigner.
# Production : Resend en SMTP, ex. smtps://resend:<clé API>@smtp.resend.com:465
# SMTP_URL=
MAIL_FROM=Lucko <noreply@lucko.fr>

# Photos de profil : hors production, le S3 local (pnpm db:up, console sur http://localhost:9001) sans rien renseigner.
# Production : bucket S3 en UE, ex. Scaleway (endpoint https://s3.fr-par.scw.cloud, région fr-par)
# S3_ENDPOINT=
# S3_REGION=fr-par
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# Analyse automatique des photos (compte sur sightengine.com) ; sans clé, chaque photo attend un admin
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# Suivi des erreurs (GlitchTip, compatible Sentry) ; sans DSN, rien n'est envoyé
# SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Serveurs Overpass de l'import des lieux OSM, essayés dans l'ordre (par défaut : public, private.coffee, mail.ru)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Clés AES-256 des adresses de rooms à domicile, « 1:<openssl rand -base64 32> », la clé active en tête ;
# hors production, une clé de dev fixe
# HOME_ADDRESS_KEYS=

# --- Site web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
# URL publique du site (canonique, sitemap, image de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# --- App mobile (Expo) ---
# Sur téléphone physique, remplacer localhost par l'IP locale de l'ordinateur
EXPO_PUBLIC_API_URL=http://localhost:3000
# Site public ouvert par les liens de l'app (pied de page, pages légales)
EXPO_PUBLIC_SITE_URL=http://localhost:3010
# Dev uniquement : joueur connecté dans l'app (en-tête x-dev-user-id, cf. DEV_AUTH_HEADER)
EXPO_PUBLIC_DEV_USER_ID=joueur-demo
# Mesure d'audience Umami (umami.qwetle.fr) : vide = rien n'est envoyé (dev)
EXPO_PUBLIC_UMAMI_WEBSITE_ID=
